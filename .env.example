# Copy this file to .env and fill in real values before running docker compose.

# Postgres
POSTGRES_PASSWORD=change-this-strong-password

# Backend
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=*

# Stripe (get these from https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public URL of your site (used for Stripe redirect URLs)
FRONTEND_URL=https://babygreensbari.it

# Initial admin account created on first boot
SEED_ADMIN_EMAIL=admin@babygreensbari.it
SEED_ADMIN_PASSWORD=change-this-strong-password

# Port nginx (frontend) listens on the host
HTTP_PORT=80
